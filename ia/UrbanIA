import os
from openai import OpenAI
from dotenv import load_dotenv

load_dotenv()

client = OpenAI(
    api_key=os.getenv("GROQ_API_KEY"),
    base_url="https://api.groq.com/openai/v1",
)

# Memória da conversa
messages = []

print("Chat iniciado! Digite 'sair' para encerrar.\n Qual e a sua queixa")

while True:
    pergunta = input("Você: ")

    if pergunta.lower() == "sair":
        print("Chat encerrado.")
        break

    # Guarda a pergunta do usuário
    messages.append({
        "role": "user",
        "content": pergunta
        })
    

    resposta = client.chat.completions.create(
        model="openai/gpt-oss-120b",
       messages=messages
       )

    texto_resposta = resposta.choices[0].message.content

   # Não esta guardando por enquato no proximo passo sera criar json para deixar salvo o historico de conversa
    # Guarda a resposta da IA 
    messages.append({
        "role": "assistant",
        "content": texto_resposta
    })

    print("Radar UrbanIA", texto_resposta)
    print()